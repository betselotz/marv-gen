manifest {
    name            = 'marv-gen'
    author          = 'EPHI Bioinformatics'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}

params {
    beast_burnin = null
    beast_log_every = 50000
    beast_burnin_states = 5000000
    beast_seed2             = 2222
    beast_seed1             = 1111
    beast_use_beagle        = false
    snp_cluster_threshold = 5
    minor_allele_freq = 0.05
    auto_exclude_damaged = false
    min_recovered_fraction = 0.0
    help                    = false
    input                   = null
    samplesheet             = null
    outdir                  = "${projectDir}/results"
    publish_dir_mode        = 'copy'

    reference               = "${projectDir}/reference_genomes/Marburg_reference.fasta"
    reference_gff           = "${projectDir}/reference_genomes/Marburg_reference.gff3"
    host_index              = "${projectDir}/reference_genomes/human_index"
    compare_fasta_dir       = "${projectDir}/reference_genomes/MARV_compare"
    metadata                = "${projectDir}/metadata/all_seq_metadata.csv"

    kraken2_db              = null
    kraken2_prebuilt_url    = "https://genome-idx.s3.amazonaws.com/kraken/k2_viral_20250714.tar.gz"
    build_kraken2_db        = false
    kraken2_custom_fasta    = null

    nextclade_dataset_dir   = "${projectDir}/database"
    nextclade_dataset_name  = "community/genspectrum/marburg/HK1980/all-lineages"

    gp_domains_csv          = "${projectDir}/assets/GP_domains_Musoke.csv"
    gp_comparators_faa      = "${projectDir}/assets/GP_comparators.faa"
    gp_max_x_fraction = 0.15

    gate_min_cov_pct = 50
    gate_breadth_min_depth = 1
    min_mean_depth = 10
    min_coverage_pct = 70
    max_n_pct = 20

    skip_host_removal       = false
    skip_kraken2 = true
    skip_primer_trim        = true
    skip_qualimap           = false
    skip_nextclade          = false
    skip_sample_qc          = false
    skip_annotation         = false
    skip_protein_annotation = false
    skip_lineage_snps       = false
    skip_diversity          = false
    skip_snp_dists          = false
    skip_dn_ds              = false
    skip_coverage_plots     = false
    skip_phylogeny          = false
    skip_treetime = true
    skip_beast              = true
    skip_gp_analysis = true
    skip_gp_tree = true
    skip_multiqc            = false

    fastp_qualified_quality = 20
    fastp_min_length        = 50
    minimap2_preset         = 'sr'
    ivar_min_quality        = 20
    ivar_min_frequency      = 0.7
    ivar_min_depth          = 1
    bcftools_ploidy         = 1
    iqtree_model            = 'GTR+F+I+G4'
    iqtree_bootstrap        = 1000
    beast_chain_length = 50000000
    focused_treetime         = true
    focused_tips             = "JN408064.1,ET_MARV_45,ET_MARV_31,ET_MARV_32,ET_MARV_23,ET_MARV_60,ET_MARV_262,ET_MARV_261"
    beast_xml = "${projectDir}/assets/marburg_hybrid_model.xml"
    multiqc_title           = 'marv-gen Report'
    multiqc_config          = null
    primer_bed              = null

    max_cpus                = 16
    max_memory              = '64.GB'
    max_time                = '48.h'
}

def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min(obj as int, params.max_cpus as int)
        } catch (all) {
            return obj
        }
    }
}

process {
    cpus   = { check_max(2 * task.attempt, 'cpus') }
    memory = { check_max(4.GB * task.attempt, 'memory') }
    time   = { check_max(4.h * task.attempt, 'time') }
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: process_low {
        cpus   = { check_max(2, 'cpus') }
        memory = { check_max(4.GB, 'memory') }
    }
    withLabel: process_medium {
        cpus   = { check_max(4, 'cpus') }
        memory = { check_max(8.GB, 'memory') }
    }
    withLabel: process_high {
        cpus   = { check_max(8, 'cpus') }
        memory = { check_max(16.GB, 'memory') }
    }
    withLabel: process_long {
        time = { check_max(24.h, 'time') }
    }
    withLabel: process_beast {
        cpus   = { check_max(4, 'cpus') }
        memory = { check_max(16.GB, 'memory') }
        time   = { check_max(48.h, 'time') }
        conda  = "${projectDir}/envs/beast_env.yaml"
    }
}

conda {
    enabled       = true
    useMamba      = false
    cacheDir      = "${HOME}/nf-conda-cache"
    createTimeout = '2 h'
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

trace.overwrite    = true
report.overwrite   = true
timeline.overwrite = true
dag.overwrite      = true

profiles {
    conda {
        conda.enabled  = true
        conda.useMamba = false
        conda.cacheDir      = "${HOME}/nf-conda-cache"
        # per-process conda via envs/*.yaml
    }
    full {
        params.skip_kraken2     = false
        params.skip_gp_analysis = false
        params.skip_gp_tree     = false
        params.skip_treetime    = false
        params.skip_beast              = true
    }
    gp {
        params.skip_gp_analysis        = false
        params.skip_gp_tree            = false
        params.skip_protein_annotation = false
        params.skip_beast              = true
    }
    local {
        process.executor = 'local'
    }
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    slurm {
        process.executor = 'slurm'
    }
}


params {
    help                    = false
    input                   = null
    samplesheet             = null
    outdir                  = "${projectDir}/results"
    publish_dir_mode        = "copy"

    // references (all relative to project)
    reference               = "${projectDir}/reference_genomes/Marburg_reference.fasta"
    reference_gff           = "${projectDir}/reference_genomes/Marburg_reference.gff3"
    host_index              = "${projectDir}/reference_genomes/human_index"
    compare_fasta_dir       = "${projectDir}/reference_genomes/MARV_compare"
    metadata                = "${projectDir}/metadata/all_seq_metadata.csv"

    // kraken
    kraken2_db              = "${projectDir}/database/kraken2_viral"
    build_kraken2_db        = false
    kraken2_custom_fasta    = null

    // nextclade
    nextclade_dataset_dir   = "${projectDir}/database"
    nextclade_dataset_name  = "community/genspectrum/marburg/HK1980/all-lineages"

    // GP analysis
    gp_domains_csv          = "${projectDir}/assets/GP_domains_Musoke.csv"
    gp_comparators_faa      = "${projectDir}/assets/GP_comparators.faa"
    gp_max_x_fraction       = 0.15

    // coverage gate
    gate_min_cov_pct        = 50
    gate_breadth_min_depth  = 1

    // full run: nothing skipped by default
    skip_host_removal       = false
    skip_kraken2            = false
    skip_primer_trim        = true
    skip_qualimap           = false
    skip_nextclade          = false
    skip_sample_qc          = false
    skip_annotation         = false
    skip_protein_annotation = false
    skip_lineage_snps       = false
    skip_diversity          = false
    skip_snp_dists          = false
    skip_dn_ds              = false
    skip_coverage_plots     = false
    skip_phylogeny          = false
    skip_treetime           = false
    skip_beast              = false
    skip_gp_analysis        = false
    skip_gp_tree            = false
    skip_multiqc            = false

    // tool params
    fastp_qualified_quality = 20
    fastp_min_length        = 50
    minimap2_preset         = "sr"
    ivar_min_quality        = 20
    ivar_min_frequency      = 0.7
    ivar_min_depth          = 1
    iqtree_model            = "GTR+F+I+G4"
    iqtree_bootstrap        = 1000
    beast_chain_length      = 1000000
    multiqc_title           = "MARV-GEN Report"
    multiqc_config          = null
    primer_bed              = null
    max_cpus                = 16
    max_memory              = "64.GB"
    max_time                = "48.h"
}
